def mittelwert(werte):
    if len(werte) == 0:
        raise ValueError("Liste darf nicht leer sein")
    return sum(werte) / len(werte)


def standardabweichung(werte, stichprobe=True):
    m = mittelwert(werte)
    nenner = len(werte) - 1 if stichprobe else len(werte)
    return (sum((w - m) ** 2 for w in werte) / nenner) ** 0.5


def sicher_in_zahl(text):
    try:
        return float(text.replace(",", "."))
    except (ValueError, AttributeError):
        return None


